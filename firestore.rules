rules_version = '2';

// ===========================================================================
// 1ATF Operational Portal — Cloud Firestore security rules
// ===========================================================================
//
// TO PUBLISH: Firebase Console → Firestore Database → Rules → paste this whole
// file → Publish. There is no deploy step in CI; the repo copy is NOT live
// until someone does that by hand. See HANDOVER.md §0.
//
// Shape of the app, in one paragraph: the three public tabs have no accounts at
// all, so everything they read must be world-readable and the one thing they
// write (a decrypt counter) must be writable by an anonymous caller. Everything
// authored lives under content/* and is written by RHQ. Two lesser roles exist
// — Company Commander (drafts intel for its own company only) and RHQ Staff
// (approves those drafts, and nothing else) — and each is granted only where it
// is named explicitly below.
//
// Collection-by-collection summary:
//
//   content/{slice}   Public operational content. World-readable, RHQ writes.
//                     Covers every SINGLE_SLICES entry in lib/store.js —
//                     narrative, territory, classified, branding, companyPages,
//                     video, intel, intelIntro, briefings, campaignDefaultStart,
//                     staffAccess. Adding a slice there needs NO rules change.
//                     content/intel additionally allows RHQ Staff (approvals).
//   campaignFrames    Campaign replay history, one doc per frame (a full cell
//                     snapshot + label + order). World-readable, RHQ writes.
//   roster            RHQ reads all; a signed-in member may read ONLY their own
//                     record. RHQ writes.
//   users/{uid}       A member reads/updates only their own profile and may not
//                     change their own role or ID number. RHQ manages all.
//   tasks / activity  RHQ-only, both directions (legacy, unrouted pages).
//   support           Anyone may file ONE bounded request; RHQ reads/actions.
//   resetRequests     Same, for forgotten passwords.
//   audit             RHQ reads/deletes; RHQ and RHQ Staff append. Never edited.
//   backups           Version history of content/*. RHQ-only READ and DELETE —
//                     never public, unlike the docs it snapshots. Append-only.
//   authIndex/{id}    Public read (login needs the credential epoch BEFORE
//                     sign-in); RHQ bumps it on a password reset.
//   intelSubmissions  COY intel approval queue. Commander sees only its own
//                     company; RHQ and RHQ Staff manage the whole queue.
//   intelStats        Anonymous per-company decrypt counts. Public read AND
//                     public create/increment, pinned to a fixed shape that
//                     carries no identity.
//
//   Everything else default-denies at the bottom of the file.
//
// KNOWN GAP, deliberate — read before "fixing" the users block: a member's role
// is written by the CLIENT at registration, copied from their roster record
// (profileFromRoster in AuthContext.jsx). Rules cannot verify it, because the
// roster is keyed by an arbitrary document id rather than by ID number, so
// there is no get() to check it against. A registered member could therefore
// write role:'RHQ' into their own users doc and become RHQ. Closing it in rules
// alone would break every legitimately RHQ- or Staff-designated account at
// first registration; the real fix is keying roster documents by ID number so
// the create rule can cross-check. Tracked in HANDOVER.md §2.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers. "RHQ" and friends are read off the caller's OWN user profile,
    // so every one of these costs a get() — keep them cheap and few.
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function roleIs(role) {
      return isSignedIn()
        && exists(userDoc())
        && get(userDoc()).data.role == role;
    }
    // Full Operations Centre authority.
    function isRHQ() {
      return roleIs('RHQ');
    }
    // An 'RHQ Staff' account: the Staff Centre plus the COY intel approval
    // queue for every company. Deliberately NOT isRHQ — it must never reach the
    // Operations Centre's other slices (branding, territory, users…), so it is
    // granted only where it is named: content/intel, intelSubmissions, and
    // append-only on audit and backups so its approvals leave a trace.
    function isRHQStaff() {
      return roleIs('RHQ Staff');
    }
    // A Company Commander bound to company `coy`. Commanders may only ever act
    // on their own company's data.
    function isCommanderOf(coy) {
      return roleIs('Company Commander')
        && get(userDoc()).data.company == coy;
    }
    // True when the signed-in caller's own auth email corresponds to `idNumber`.
    // Auth emails are synthesised as id-<idNumber>[.v<epoch>]@1atf.unit (see
    // idToEmail() in AuthContext.jsx). matches() is anchored to the whole
    // string. NOTE: the email is built from a cleaned id (lowercased, non
    // -alphanumerics stripped), so a roster record whose idNumber carries spaces
    // or punctuation will not match — the same assumption registration's
    // where('idNumber','==',id) query already relies on.
    function isOwnId(idNumber) {
      return isSignedIn()
        && request.auth.token.email.matches(
             'id-' + idNumber + '([.]v[0-9]+)?@1atf[.]unit');
    }
    // True when a (possibly missing) field is a string no longer than `max`.
    function strOk(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // ------------------------------------------------------------------
    // Public site content
    // ------------------------------------------------------------------
    // Anyone can read; RHQ edits. Every SINGLE_SLICES doc lands here, including
    // staffAccess — the shared Staff Centre password is therefore world
    // -readable. That is accepted, not overlooked: it was previously compiled
    // into the JS bundle, which is equally readable. It is a latch, not a lock;
    // real authority is the Staff / RHQ Staff roles. See HANDOVER.md §2.
    match /content/{slice} {
      allow read: if true;
      allow write: if isRHQ();
    }

    // Approving a COY submission publishes into content/intel, so RHQ Staff
    // needs write on THIS slice and no other. Overlapping matches are OR'd in
    // Firestore, so this widens content/intel only — every other content/*
    // document stays RHQ-write-only under the rule above.
    match /content/intel {
      allow read: if true;
      allow write: if isRHQ() || isRHQStaff();
    }

    // ------------------------------------------------------------------
    // Campaign replay frames
    // ------------------------------------------------------------------
    // One document per frame (a full cell snapshot, not a diff) so RHQ can
    // edit, reorder, duplicate or delete any frame independently. Read by every
    // visitor — the public Home map plays these back.
    match /campaignFrames/{id} {
      allow read: if true;
      allow write: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Roster
    // ------------------------------------------------------------------
    // RHQ reads every record. A signed-in member may additionally read ONLY
    // their own — which is what temporary-password registration depends on: it
    // queries where('idNumber','==',id), returning at most one document, so
    // this rule permits exactly that one and denies everyone else's. A
    // collection-wide list by a non-RHQ caller is denied outright (rules never
    // filter a query, they only accept or reject it); store.js swallows that.
    // Writes are RHQ-only.
    match /roster/{id} {
      allow read:  if isRHQ() || isOwnId(resource.data.idNumber);
      allow write: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Personnel profiles
    // ------------------------------------------------------------------
    // A member reads only their own profile; RHQ reads all. On self-update a
    // member may not change their role or ID number — that is the anti
    // -escalation check, and it is why the update rule spells both fields out.
    // Profiles are never deleted by their owner.
    // See the KNOWN GAP note in the file header about create.
    match /users/{uid} {
      allow read:   if isRHQ() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isRHQ()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.idNumber == resource.data.idNumber);
      allow delete: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Distributed tasks + activity feed
    // ------------------------------------------------------------------
    // RHQ-only in both directions. Their only readers are the legacy, unrouted
    // Tasks.jsx / Activity.jsx pages — see CLAUDE.md. If either is ever revived
    // as a member-facing page, this is the block that has to change.
    match /tasks/{id} {
      allow read:  if isRHQ();
      allow write: if isRHQ();
    }
    match /activity/{id} {
      allow read:  if isRHQ();
      allow write: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Help / support inbox
    // ------------------------------------------------------------------
    // Anyone, including a signed-out visitor, may file ONE bounded request —
    // automatic error reports come through here too (DataContext.reportError),
    // and those fire before anybody has signed in. The key list must stay in
    // step with that record's shape or reports start silently failing.
    // Nobody but RHQ can read the inbox back.
    match /support/{id} {
      allow create: if request.resource.data.keys()
                        .hasOnly(['category','name','idNumber','contact','message','code','auto','ts','status'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && strOk(request.resource.data, 'category', 64)
        && strOk(request.resource.data, 'name', 200)
        && strOk(request.resource.data, 'idNumber', 64)
        && strOk(request.resource.data, 'contact', 200)
        && strOk(request.resource.data, 'code', 32);
      allow read, update, delete: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Forgotten-password inbox
    // ------------------------------------------------------------------
    // Anyone may raise a reset request; RHQ reads it and actions it by bumping
    // the credential epoch in authIndex.
    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['idNumber','ts','status'])
        && request.resource.data.idNumber is string
        && request.resource.data.idNumber.size() > 0
        && request.resource.data.idNumber.size() <= 64;
      allow read, update, delete: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Audit log
    // ------------------------------------------------------------------
    // Record of RHQ actions. Append-only: never edited in place, or it is not a
    // record. RHQ Staff may APPEND (every approval it makes is logged) but can
    // neither read the log back nor delete from it — the Audit Log stays an
    // Operations Centre view.
    match /audit/{id} {
      allow read, delete: if isRHQ();
      allow create: if isRHQ() || isRHQStaff();
      allow update: if false;
    }

    // ------------------------------------------------------------------
    // Backups / version history
    // ------------------------------------------------------------------
    // Snapshots of content/* taken automatically by DataContext.updateSlice
    // before it overwrites a slice (lib/backups.js). RHQ-only in BOTH
    // directions — unlike the documents it snapshots, this is never public,
    // which is exactly what makes it safe to version the staffAccess slice.
    // Immutable once written: a backup that can be edited is not a backup.
    //
    // RHQ Staff can CREATE but not read, because its content/intel approval
    // save has to be able to leave a restore point behind. The prune pass that
    // follows a write reads the collection and will therefore be denied for
    // that role; recordBackup never throws, so the save itself still succeeds.
    match /backups/{id} {
      allow read:   if isRHQ();
      allow create: if isRHQ() || isRHQStaff();
      allow update: if false;
      allow delete: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Public auth-version index
    // ------------------------------------------------------------------
    // Nothing sensitive — just the credential epoch — and login has to read it
    // BEFORE sign-in to work out which synthesised email to use, so it must be
    // public. RHQ bumps it on a reset, and may write nothing but that one int.
    match /authIndex/{id} {
      allow read:  if true;
      allow write: if isRHQ()
        && request.resource.data.keys().hasOnly(['pwVersion'])
        && request.resource.data.pwVersion is int;
    }

    // ------------------------------------------------------------------
    // Intel approval queue (drafts)
    // ------------------------------------------------------------------
    // Company Commanders submit intel changes for THEIR company; nothing is
    // public until an approval writes content/intel and clears the submission.
    // A commander may only touch submissions carrying their own company code —
    // and because rules never filter, a commander's list query must itself be
    // filtered by company or the whole read is rejected (the app does this).
    // RHQ and RHQ Staff manage the entire queue.
    match /intelSubmissions/{id} {
      allow read:   if isRHQ() || isRHQStaff()
                    || isCommanderOf(resource.data.company);
      allow create: if isRHQ() || isRHQStaff()
                    || (isCommanderOf(request.resource.data.company)
                        && request.resource.data.status == 'pending');
      // A commander may edit their own draft but never reassign it to another
      // company, which would put it in front of the wrong approver.
      allow update: if isRHQ() || isRHQStaff()
                    || (isCommanderOf(resource.data.company)
                        && request.resource.data.company == resource.data.company);
      // Approving and dismissing both clear the submission.
      allow delete: if isRHQ() || isRHQStaff()
                    || isCommanderOf(resource.data.company);
    }

    // ------------------------------------------------------------------
    // Anonymous decrypt counts
    // ------------------------------------------------------------------
    // How many devices have solved each intel fragment, per company. The Intel
    // tab has no login, so this MUST be writable by an unauthenticated visitor
    // — there is no identity to gate on. It is pinned by SHAPE instead: a
    // company code, a fragment id, a count and a timestamp, and nothing else.
    // There is no identity in these documents to protect.
    //
    //   create: the first solve, which must start the count at exactly 1.
    //   update: exactly +1, and may not rewrite which company or fragment the
    //           document is about.
    //
    // So the worst an abusive client can do is inflate one counter one request
    // at a time — it can never forge a total or move one between companies.
    // Treat the numbers as an engagement signal, never a score. This is the
    // ONLY rule in the file granting an anonymous caller a write; it is the one
    // most worth putting through the emulator (HANDOVER.md §1), and it relies
    // on the rules engine seeing increment() already resolved in
    // request.resource.data. Deletes are RHQ-only (resetting a term's counts).
    function statsShapeOk(d) {
      return d.keys().hasOnly(['company','fragmentId','solves','lastAt'])
        && d.company is string && d.company.size() <= 8
        && d.fragmentId is string && d.fragmentId.size() <= 64
        && d.lastAt is number;
    }
    match /intelStats/{id} {
      allow read:   if true;
      allow create: if statsShapeOk(request.resource.data)
        && request.resource.data.solves == 1;
      allow update: if statsShapeOk(request.resource.data)
        && request.resource.data.solves == resource.data.solves + 1
        && request.resource.data.company == resource.data.company
        && request.resource.data.fragmentId == resource.data.fragmentId;
      allow delete: if isRHQ();
    }

    // ------------------------------------------------------------------
    // Default deny
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
