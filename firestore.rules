rules_version = '2';

// Security model for the 1ATF portal.
//
//  - Public operational content (content/*) is world-readable; only RHQ writes.
//    Covers every single-value slice in store.js SINGLE_SLICES — narrative,
//    territory, classified, branding, companyPages, video, intel, intelIntro,
//    briefings. Adding a slice there needs NO rules change; it is already
//    covered by this block.
//  - campaignFrames: the campaign replay history, one document per frame
//    (full cell snapshot + label + order) so RHQ can edit/reorder/delete any
//    frame independently. World-readable like content/*; only RHQ writes.
//  - intelSubmissions: the Company Commander approval queue — a commander
//    reads/writes only their own company's submissions, RHQ manages all.
//  - intelStats: anonymous per-company decrypt counts. Public read AND public
//    create/increment (the Intel tab has no login), locked to a fixed shape
//    carrying no identity — see the block below for exactly what that allows.
//  - roster: RHQ reads all; a signed-in member may additionally read ONLY their
//    own record (matched via their auth email against the record's idNumber) —
//    this is what temporary-password registration relies on, before the member
//    has a profile that marks them RHQ. Only RHQ writes.
//  - tasks / activity: RHQ-only reads (their only current readers are legacy,
//    unlinked pages — see CLAUDE.md). Only RHQ writes.
//  - users/{uid}: a member may read and update ONLY their own profile, and may
//    NOT change their own role or ID number (anti-escalation); RHQ manages all.
//  - support / resetRequests: anyone (incl. signed-out) may submit a single,
//    size-bounded request; only RHQ can read or action them.
//  - authIndex/{id}: public read (login computes the credential epoch before
//    sign-in); only RHQ bumps it on a password reset.
//  - Everything else is denied by default.
//
// "RHQ" is determined by the role field on the caller's own user profile.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function isRHQ() {
      return isSignedIn()
        && exists(userDoc())
        && get(userDoc()).data.role == 'RHQ';
    }
    // A Company Commander bound to company `coy`. Commanders may only ever act on
    // their own company's data.
    function isCommanderOf(coy) {
      return isSignedIn()
        && exists(userDoc())
        && get(userDoc()).data.role == 'Company Commander'
        && get(userDoc()).data.company == coy;
    }
    // True when the signed-in caller's own auth email corresponds to `idNumber`.
    // Auth emails are synthesised as id-<idNumber>[.v<epoch>]@1atf.unit (see
    // idToEmail() in AuthContext.jsx); idNumber is digits-only so no cleaning is
    // needed to compare it against the email's id- segment.
    function isOwnId(idNumber) {
      return isSignedIn()
        && request.auth.token.email.matches(
             'id-' + idNumber + '([.]v[0-9]+)?@1atf[.]unit');
    }
    // True when a (possibly missing) field is a string no longer than `max`.
    function strOk(data, key, max) {
      return !(key in data) || (data[key] is string && data[key].size() <= max);
    }

    // ------------------------------------------------------- public site content
    // Anyone can read; RHQ edits.
    match /content/{doc} {
      allow read: if true;
      allow write: if isRHQ();
    }

    // ---------------------------------------------------- campaign replay frames
    // One document per frame (full cell snapshot). Anyone can read; RHQ edits,
    // reorders, duplicates or deletes any frame independently.
    match /campaignFrames/{id} {
      allow read: if true;
      allow write: if isRHQ();
    }

    // --------------------------------------------------------------- roster
    // RHQ reads every record. A signed-in member may additionally read ONLY
    // their own record — this is what temporary-password registration relies
    // on: it queries where('idNumber','==', id), which returns at most one
    // doc, so this rule permits exactly that doc and denies everyone else's.
    // Writes are RHQ-only.
    match /roster/{id} {
      allow read:  if isRHQ() || isOwnId(resource.data.idNumber);
      allow write: if isRHQ();
    }

    // ------------------------------------------ distributed tasks + activity feed
    // RHQ-only reads. (Their only current readers are the legacy, unlinked
    // Tasks.jsx/Activity.jsx pages — see CLAUDE.md.)
    match /tasks/{id} {
      allow read:  if isRHQ();
      allow write: if isRHQ();
    }
    match /activity/{id} {
      allow read:  if isRHQ();
      allow write: if isRHQ();
    }

    // ------------------------------------------------------ personnel profiles
    // A member reads only their own profile; RHQ reads all. On self-update a
    // member may not change their role or ID number — only RHQ can. Profiles are
    // never deleted by their owner.
    match /users/{uid} {
      allow read:   if isRHQ() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isRHQ()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.idNumber == resource.data.idNumber);
      allow delete: if isRHQ();
    }

    // ------------------------------------------------------- help / support inbox
    // Anyone (incl. signed-out) may file ONE bounded request; RHQ reads/actions.
    match /support/{id} {
      allow create: if request.resource.data.keys()
                        .hasOnly(['category','name','idNumber','contact','message','code','auto','ts','status'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && strOk(request.resource.data, 'category', 64)
        && strOk(request.resource.data, 'name', 200)
        && strOk(request.resource.data, 'idNumber', 64)
        && strOk(request.resource.data, 'contact', 200)
        && strOk(request.resource.data, 'code', 32);
      allow read, update, delete: if isRHQ();
    }

    // --------------------------------------------------- forgotten-password inbox
    // Anyone may raise a reset request; RHQ reads and actions it.
    match /resetRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['idNumber','ts','status'])
        && request.resource.data.idNumber is string
        && request.resource.data.idNumber.size() > 0
        && request.resource.data.idNumber.size() <= 64;
      allow read, update, delete: if isRHQ();
    }

    // ------------------------------------------------------------- audit log
    // Record of RHQ actions. RHQ only — created, read and cleared by RHQ; never
    // edited in place.
    match /audit/{id} {
      allow read, create, delete: if isRHQ();
      allow update: if false;
    }

    // -------------------------------------------------- public auth-version index
    // No sensitive data — just the credential epoch — so login can read it before
    // sign-in. RHQ bumps it on a reset.
    match /authIndex/{id} {
      allow read:  if true;
      allow write: if isRHQ()
        && request.resource.data.keys().hasOnly(['pwVersion'])
        && request.resource.data.pwVersion is int;
    }

    // ------------------------------------------- intel approval queue (drafts)
    // Company Commanders submit intel changes for THEIR company; the change is
    // not public until RHQ approves it (approval writes content/intel and clears
    // the submission). A commander may only read/write submissions carrying
    // their own company code; RHQ manages the whole queue. Commander list
    // queries must be filtered by company (the app does this) to satisfy read.
    match /intelSubmissions/{id} {
      allow read:   if isRHQ() || isCommanderOf(resource.data.company);
      allow create: if isRHQ() || (isCommanderOf(request.resource.data.company)
                                   && request.resource.data.status == 'pending');
      allow update: if isRHQ() || (isCommanderOf(resource.data.company)
                                   && request.resource.data.company == resource.data.company);
      allow delete: if isRHQ() || isCommanderOf(resource.data.company);
    }

    // ------------------------------------------------- anonymous decrypt counts
    // How many devices have solved each intel fragment, per company. The Intel
    // tab has no login, so this MUST be writable by an unauthenticated visitor
    // — which is why the document is constrained to a fixed shape carrying
    // nothing but a company code, a fragment id, a count and two timestamps.
    // There is no identity here to protect.
    //
    // create: the first solve, which must start the count at exactly 1.
    // update: exactly +1, and may not rewrite which company/fragment the doc
    //         is about — so the worst an abusive client can do is inflate one
    //         counter one request at a time, never forge or move a total.
    // Deletes are RHQ-only (resetting a term's counts).
    function statsShapeOk(d) {
      return d.keys().hasOnly(['company','fragmentId','solves','lastAt'])
        && d.company is string && d.company.size() <= 8
        && d.fragmentId is string && d.fragmentId.size() <= 64
        && d.lastAt is number;
    }
    match /intelStats/{id} {
      allow read:   if true;
      allow create: if statsShapeOk(request.resource.data)
        && request.resource.data.solves == 1;
      allow update: if statsShapeOk(request.resource.data)
        && request.resource.data.solves == resource.data.solves + 1
        && request.resource.data.company == resource.data.company
        && request.resource.data.fragmentId == resource.data.fragmentId;
      allow delete: if isRHQ();
    }

    // ------------------------------------------------------------- default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
